<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_cream">

    <!-- 1. HEADER WAVE (Modul 9) -->
    <!-- Tingginya 220dp agar aman menutupi teks dan profil -->
    <View
        android:id="@+id/headerWave"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:background="@drawable/bg_header_wave"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 2. TEKS SAPAAN & FOTO PROFIL -->
    <TextView
        android:id="@+id/tvHalo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="56dp"
        android:text="Halo, Fika!"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"
        android:text="Mau kemana hari ini?"
        android:textColor="#E8EFE9"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvHalo" />

    <!-- Ikon Profil dikembalikan ke kanan atas -->

    <!-- 3. SEARCH BAR -->

    <ImageView
        android:id="@+id/ivProfile"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_rounded_container"
        android:padding="8dp"
        android:src="@drawable/ic_info"
        app:layout_constraintBottom_toBottomOf="@id/tvSubtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvHalo"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/tvFakeSearchBar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_rounded_container"
        app:drawableStartCompat="@android:drawable/ic_menu_search"
        android:drawablePadding="12dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:text="Cari Destinasi, Kota, atau tempat..."
        android:textColor="@color/deep_charcoal"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle" />

    <!-- 4. GRIDLAYOUT MODUL 9 (6 Menu) -->
    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/gridMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="24dp"
        app:columnCount="3"
        app:rowCount="2"
        app:layout_constraintTop_toBottomOf="@id/tvFakeSearchBar">

        <!-- Tombol 1: Alam -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMenuAlam"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_columnWeight="1"
            android:text="Alam"
            android:textColor="@color/forest_green"
            app:icon="@drawable/ic_alam"
            app:iconGravity="top"
            app:iconTint="@color/forest_green" />

        <!-- Tombol 2: Pulau -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMenuPulau"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_columnWeight="1"
            android:text="Pulau"
            android:textColor="@color/forest_green"
            app:icon="@drawable/ic_pulau"
            app:iconGravity="top"
            app:iconTint="@color/forest_green" />

        <!-- Tombol 3: Kuliner -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMenuKuliner"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_columnWeight="1"
            android:text="Kuliner"
            android:textColor="@color/forest_green"
            app:icon="@drawable/ic_kuliner"
            app:iconGravity="top"
            app:iconTint="@color/forest_green" />

        <!-- Tombol 4: Hotel -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMenuHotel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_columnWeight="1"
            android:text="Hotel"
            android:textColor="@color/forest_green"
            app:icon="@drawable/ic_hotel"
            app:iconGravity="top"
            app:iconTint="@color/forest_green" />

        <!-- Tombol 5: Favorite -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMenuFavorite"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_columnWeight="1"
            android:text="Favorite"
            android:textColor="@color/forest_green"
            app:icon="@drawable/ic_favorite"
            app:iconGravity="top"
            app:iconTint="@color/forest_green" />

        <!-- Tombol 6: My Pack -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMenuMyPack"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_columnWeight="1"
            android:text="My Pack"
            android:textColor="@color/forest_green"
            app:icon="@drawable/ic_work"
            app:iconGravity="top"
            app:iconTint="@color/forest_green" />
    </androidx.gridlayout.widget.GridLayout>

    <!-- 5. DESTINASI POPULER (Dikembalikan seperti Mockup) -->
    <TextView
        android:id="@+id/tvDestinasiPopulerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:text="Destinasi Populer"
        android:textColor="@color/forest_green"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/gridMenu" />

    <!-- Area Card Horizontal -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="24dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/tvDestinasiPopulerTitle">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Card Destinasi Gunung Prau -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="220dp"
                android:layout_height="140dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="@color/forest_green"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:text="Keindahan Alam\nGunung Prau"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>