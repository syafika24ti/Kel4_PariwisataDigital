<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_cream"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="My Pack"
        android:textColor="@color/forest_green"
        android:textSize="26sp"
        android:textStyle="bold" />

    <!-- DAFTAR 1: Menggunakan ArrayAdapter -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Checklist Perlengkapan (ArrayAdapter)"
        android:textColor="@color/deep_charcoal"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/lvChecklist"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:divider="@color/gray"
        android:dividerHeight="1dp" />

    <!-- DAFTAR 2: Menggunakan SimpleAdapter -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rencana Perjalanan (SimpleAdapter)"
        android:textColor="@color/deep_charcoal"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/lvTravelInfo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:divider="@color/gray"
        android:dividerHeight="1dp" />

</LinearLayout>