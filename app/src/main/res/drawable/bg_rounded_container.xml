<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Warna digelapkan sedikit agar lebih kontras dengan background -->
    <solid android:color="#D4E4D7" />

    <!-- Lengkungan sudut sempurna -->
    <corners android:radius="24dp" />

    <!-- Tambahan garis tepi tipis (stroke) agar bentuk kotaknya lebih tegas -->
    <stroke
        android:width="1dp"
        android:color="@color/sage_mist" />
</shape>